# Allow only the two build inputs and the SDK selector.
**
!global.json
!TaskDev-Front/
!TaskDev-Front/**
!TaskDev-Back/
TaskDev-Back/**
!TaskDev-Back/TaskDev-Back/
!TaskDev-Back/TaskDev-Back/**

# Exclude local configuration and artifacts within allowed directories.
**/.env
**/.env.*
**/.envrc
**/*.env
**/appsettings*.json
**/app.json
**/secrets.json
**/.npmrc
**/.neon
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/.git
**/.vs
**/.idea
**/.taskdev-tools
**/node_modules
**/dist
**/bin
**/obj
**/artifacts
**/TestResults
**/coverage
**/*.log
**/*.tsbuildinfo
**/*.user
**/*.db*
