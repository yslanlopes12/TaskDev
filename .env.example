# Copie para .env e preencha somente na sua máquina.
# PostgreSQL externo: informe a URL do seu próprio banco.
DATABASE_URL=
# Opcional: conexão direta para as migrações.
DATABASE_URL_UNPOOLED=
# Obrigatória no Docker. Gere com: openssl rand -base64 32
AGENT_ENCRYPTION_KEY=
# Somente para compose.postgres.yaml. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
# Porta HTTP da interface, publicada no loopback por padrão.
TASKDEV_PORT=8080
# Ative apenas quando a interface estiver acessível por HTTPS.
Security__SecureCookies=false
# Ative temporariamente para criar o primeiro administrador em uma rede privada.
Admin__BootstrapEnabled=false
# Somente em uma instância confiável: permite Ollama em localhost:11434.
Agent__AllowLocalOllama=false
